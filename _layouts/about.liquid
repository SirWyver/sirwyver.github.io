---
layout: default
---
<div class="portfolio">
  <header class="hero">
    <div class="hero-copy">
      <p class="eyebrow">Research / {{ page.location }}</p>
      <h1>
        {{ site.first_name }}
        {{ site.last_name }}
      </h1>
      <p class="hero-role">
        {{ page.role }} at <a href="{{ page.organization_url }}">{{ page.organization }}</a>
      </p>
      <p class="hero-statement">{{ page.subtitle }}</p>
      {% if page.social %}
        <nav class="contact-links" aria-label="Contact and profiles">
          {% if site.email %}
            <a class="contact-primary" href="mailto:{{ site.email | encode_email }}">Email <span aria-hidden="true">&#8599;</span></a>
          {% endif %}
          {% if site.scholar_userid %}
            <a href="https://scholar.google.com/citations?user={{ site.scholar_userid }}">Scholar <span aria-hidden="true">&#8599;</span></a>
          {% endif %}
          {% if site.github_username %}
            <a href="https://github.com/{{ site.github_username }}">GitHub <span aria-hidden="true">&#8599;</span></a>
          {% endif %}
          {% if site.x_username %}
            <a href="https://x.com/{{ site.x_username }}">X <span aria-hidden="true">&#8599;</span></a>
          {% endif %}
        </nav>
      {% endif %}
    </div>
    {% if page.profile.image %}
      <div class="hero-portrait">
        {% assign profile_image_path = page.profile.image | prepend: 'assets/img/' %}
        {%
          include figure.liquid loading="eager" path=profile_image_path
          sizes="(min-width: 768px) 184px, (min-width: 576px) 128px, 88px" alt=page.profile.image_alt
          width=400 height=400 cache_bust=true fetchpriority="high"
        %}
        <p>
          {{ page.organization }}
          <span aria-hidden="true">&middot;</span> {{ page.location }}
        </p>
      </div>
    {% endif %}
  </header>

  {% if page.research_topics %}
    <ul class="research-topics" aria-label="Research interests">
      {% for topic in page.research_topics %}
        <li>{{ topic }}</li>
      {% endfor %}
    </ul>
  {% endif %}

  <section class="portfolio-section background-section" aria-labelledby="background-heading">
    <div class="background-copy">
      <h2 id="background-heading">About me</h2>
      {{ content }}
    </div>
    {% if page.academic_service %}
      <aside class="service-panel" aria-labelledby="service-heading">
        <h3 id="service-heading">Academic service</h3>
        <dl>
          {% for item in page.academic_service %}
            <dt>{{ item.role }}</dt>
            <dd>{{ item.venues }}</dd>
          {% endfor %}
        </dl>
      </aside>
    {% endif %}
  </section>

  {% if page.news and site.announcements.enabled %}
    <section class="portfolio-section news-section" aria-labelledby="news-heading">
      <div class="section-heading">
        <h2 id="news-heading">News &amp; updates</h2>
        <a class="text-link" href="{{ '/news/' | relative_url }}">All updates <span aria-hidden="true">&#8594;</span></a>
      </div>
      {% include news.liquid limit=true %}
    </section>
  {% endif %}

  {% if page.selected_papers %}
    <section class="portfolio-section" id="research" aria-labelledby="research-heading">
      <div class="section-heading">
        <div>
          <h2 id="research-heading">Selected publications &amp; releases</h2>
        </div>
        <a class="text-link" href="{{ '/publications/' | relative_url }}">All publications <span aria-hidden="true">&rarr;</span></a>
      </div>
      {% include selected_papers.liquid %}
      <a class="archive-link" href="{{ '/publications/' | relative_url }}"
        >Explore the full publication archive <span aria-hidden="true">&rarr;</span></a
      >
    </section>
  {% endif %}

  {% if site.latest_posts.enabled %}
    <section class="portfolio-section" aria-labelledby="posts-heading">
      <h2 id="posts-heading">Latest posts</h2>
      {% include latest_posts.liquid %}
    </section>
  {% endif %}
</div>
