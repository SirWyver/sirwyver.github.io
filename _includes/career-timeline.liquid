<ol class="career-timeline">
  {% for item in include.items %}
    <li>
      <p class="career-period">{{ item.period }}</p>
      <div>
        <h3>{{ item.title }}</h3>
        <p class="career-institution">{{ item.institution }}</p>
        {% if item.description %}
          <div class="career-description">{{ item.description | markdownify }}</div>
        {% endif %}
      </div>
    </li>
  {% endfor %}
</ol>
